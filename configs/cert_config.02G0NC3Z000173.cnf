# =============================================================================
# Certificado A1 Mockado - Arquivo de Configuracao
# =============================================================================
# CNPJ (formatado) : 02.G0N.C3Z/0001-73
# CNPJ (limpo)     : 02G0NC3Z000173
# Razao Social     : Teste 002 de CNPJ Alfanumerico 20260416
# Responsavel      : Anderson Silva de Miranda
# CPF Responsavel  : 093.427.717-69
# Gerado em        : 2026-04-15
# =============================================================================

[ req ]
default_bits        = 2048
default_md          = sha256
prompt              = no
distinguished_name  = dn
x509_extensions     = v3_ext
string_mask         = utf8only

[ dn ]
C  = BR
ST = SP
L  = Sao Paulo
O  = ICP-Brasil
OU = Certificado A1 Mock - Uso Exclusivo para Testes
CN = Teste 002 de CNPJ Alfanumerico 20260416:02G0NC3Z000173

[ v3_ext ]
basicConstraints        = CA:FALSE
keyUsage                = digitalSignature, keyEncipherment, nonRepudiation
extendedKeyUsage        = clientAuth, emailProtection
subjectKeyIdentifier    = hash
authorityKeyIdentifier  = keyid,issuer
subjectAltName          = @alt_names

[ alt_names ]
# OID 2.16.76.1.3.3 = CNPJ do titular (14 caracteres, sem pontuacao)
otherName.1 = 2.16.76.1.3.3;UTF8:02G0NC3Z000173

# OID 2.16.76.1.3.1 = DataNasc(8) + CPF(11) + NIS(11) + RG(10)
#                      00000000 + 09342771769 + 00000000000 + 0000000000
otherName.2 = 2.16.76.1.3.1;UTF8:00000000093427717690000000000000000000000000000000

# OID 2.16.76.1.3.4 = Nome do responsavel pelo certificado PJ
otherName.3 = 2.16.76.1.3.4;UTF8:Anderson Silva de Miranda

# OID 2.16.76.1.3.6 = CEP do endereco do titular (8 digitos)
otherName.4 = 2.16.76.1.3.6;UTF8:02341001

# OID 2.16.76.1.3.2 = Nome do responsavel (redundancia ICP-Brasil)
otherName.5 = 2.16.76.1.3.2;UTF8:Anderson Silva de Miranda

# OID 2.16.76.1.3.7 = Endereco completo (sem acentos)
otherName.6 = 2.16.76.1.3.7;UTF8:Avenida Nova Cantareira 3443 Tucuruvi Sao Paulo SP

# E-mail para contato (simulado)
email = anderson.miranda@teste.mock.br
